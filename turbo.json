{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".node-version",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "config/**",
    "modules/*/manifest.json",
    "schemas/**",
    "data/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "@empire/batteries-world-monitor#test": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
