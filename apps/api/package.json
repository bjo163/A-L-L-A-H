{
  "name": "@empire/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @empire/api-contract build && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "db:sync": "tsx src/scripts/sync.ts",
    "db:preflight": "tsx src/scripts/sync.ts --dry-run",
    "db:sync:smoke": "tsx src/scripts/sync-smoke.ts",
    "dictionary:migration:dry-run": "tsx src/scripts/migrate-legacy-dictionary.ts --dry-run",
    "dictionary:migration:apply": "tsx src/scripts/migrate-legacy-dictionary.ts --apply",
    "start": "pnpm --filter @empire/api-contract build && node dist/index.js",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@empire/api-contract": "workspace:*",
    "@empire/batteries": "workspace:*",
    "@empire/batteries-base": "workspace:*",
    "@empire/batteries-dna": "workspace:*",
    "@empire/batteries-world-monitor": "workspace:*",
    "@empire/module-kit": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.9.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.7",
    "knex": "^3.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
