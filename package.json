{
  "name": "empire-of-the-light",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs && node scripts/validate-monorepo.mjs && node scripts/validate-batteries-dna.mjs && node scripts/validate-ui-boundary.mjs && node scripts/validate-ui-assets.mjs && node scripts/validate-ui-svg.mjs && node scripts/audit-ui-contrast.mjs",
    "audit:ui-boundary": "node scripts/validate-ui-boundary.mjs",
    "validate:ui-svg": "node scripts/validate-ui-svg.mjs",
    "audit:ui-contrast": "node scripts/audit-ui-contrast.mjs",
    "audit:ui-css": "node scripts/audit-ui-css-duplicates.mjs",
    "validate:ui-assets": "node scripts/validate-ui-assets.mjs",
    "world-monitor:runtime-smoke": "pnpm --filter @empire/api exec tsx src/scripts/world-monitor-runtime-smoke.ts",
    "module:test": "node --test packages/module-kit/test/*.test.mjs",
    "dna:generate": "node scripts/generate-batteries-dna.mjs",
    "dna:validate": "node scripts/validate-batteries-dna.mjs",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/validate.mjs && node scripts/validate-monorepo.mjs && node scripts/validate-batteries-dna.mjs && node --test packages/module-kit/test/*.test.mjs",
    "db:sync": "pnpm --filter @empire/api db:sync",
    "db:preflight": "pnpm --filter @empire/api db:preflight",
    "db:sync:smoke": "pnpm --filter @empire/api db:sync:smoke"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}
