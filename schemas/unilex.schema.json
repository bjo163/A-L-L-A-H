{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://empireofthelight.example/schemas/unilex.schema.json",
  "title": "UNILEX Registry v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "status": {
      "enum": ["DRAFT", "PROPOSED_NOT_ADOPTED", "ADOPTED", "DEPRECATED"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "relationTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["relatedTo", "inspiredBy", "distinctFrom", "exactMatch", "closeMatch", "narrowerThan", "broaderThan"] }
    },
    "canonicalRules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "preferredLabel", "definition", "relations", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[USTP][0-9]{3}$" },
        "domain": { "enum": ["UNIVERSAL", "SCRIPTURE", "TEXT_SOURCE", "PROJECT"] },
        "kind": { "type": "string", "minLength": 1 },
        "preferredLabel": {
          "$ref": "#/$defs/localizedText",
          "description": "English (en) is canonical; Indonesian (id) is the initial localization.",
          "minProperties": 2,
          "required": ["en", "id"]
        },
        "definition": {
          "$ref": "#/$defs/localizedText",
          "description": "Draft definitions may be incomplete. Approved entries require English and Indonesian definitions; source-language text belongs in a referenced source record."
        },
        "alternateLabels": {
          "type": "object",
          "patternProperties": {
            "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "sourceReferences": { "type": "array", "items": { "$ref": "#/$defs/sourceReference" } },
        "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "status": { "enum": ["DRAFT_REVIEW", "SOURCE_CHECK", "LINGUISTIC_REVIEW", "APPROVED", "DEPRECATED"] },
        "review": { "$ref": "#/$defs/review" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "APPROVED" } }, "required": ["status"] },
          "then": { "properties": { "preferredLabel": { "required": ["en", "id"] }, "definition": { "required": ["en", "id"] } } }
        }
      ]
    },
    "sourceReference": {
      "type": "object", "additionalProperties": false, "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 }, "edition": { "type": "string" },
        "locator": { "type": "string" }, "url": { "type": "string", "format": "uri" }, "note": { "type": "string" }
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false, "required": ["type", "targetId"],
      "properties": {
        "type": { "enum": ["relatedTo", "inspiredBy", "distinctFrom", "exactMatch", "closeMatch", "narrowerThan", "broaderThan"] },
        "targetId": { "type": "string", "pattern": "^[USTP][0-9]{3}$" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reviewer": { "type": "string" }, "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 }, "reviewedAt": { "type": "string", "format": "date-time" },
        "decision": { "enum": ["approve", "revise", "reject"] }, "notes": { "type": "string" },
        "sourceVersion": { "type": "string" }
      }
    }
  }
}
