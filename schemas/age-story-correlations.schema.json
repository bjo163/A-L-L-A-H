{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Age Story Correlations v1.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "registryId",
    "records"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "registryId": {
      "const": "AGE_STORY_CORRELATIONS"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "key",
          "category",
          "unit",
          "sourceClass",
          "sourceReferences",
          "status",
          "usableForAuthorization",
          "usableForDivineJudgment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^N[0-9]{2}$"
          },
          "key": {
            "type": "string",
            "minLength": 3
          },
          "category": {
            "type": "string"
          },
          "numericValue": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "sourceClass": {
            "type": "string"
          },
          "sourceReferences": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "ref",
                "url"
              ],
              "properties": {
                "ref": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "status": {
            "const": "DRAFT_REVIEW"
          },
          "usableForAuthorization": {
            "const": false
          },
          "usableForDivineJudgment": {
            "const": false
          }
        }
      }
    }
  }
}
