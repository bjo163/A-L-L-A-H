{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned Journey Path",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scope",
    "ownerId",
    "status",
    "version",
    "mandateId",
    "riskReviewId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "SELF",
        "COMMUNITY",
        "GLOBAL"
      ]
    },
    "ownerId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "RESEARCHING",
        "REVIEW",
        "PILOT",
        "ACTIVE",
        "MAINTAIN",
        "SUSPENDED",
        "RETIRED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "mandateId": {
      "type": "string",
      "minLength": 1
    },
    "riskReviewId": {
      "type": "string",
      "minLength": 1
    },
    "maintainerId": {
      "type": "string"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    }
  }
}
