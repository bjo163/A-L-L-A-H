{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://empireofthelight.example/schemas/asma-project-mapping.schema.json",
  "title": "Project Mapping Inspired by an Asma al-Husna Source Record",
  "description": "A project analogy record, not a theological definition. It grants no authority and must not claim divine capability for software.",
  "type": "object", "additionalProperties": false,
  "required": ["id", "sourceConcept", "projectMapping", "relation", "status", "authorityGranted"],
  "properties": {
    "id": { "type": "string", "pattern": "^ASM-P-[a-z0-9-]+$" },
    "sourceConcept": {
      "type": "object", "additionalProperties": false,
      "required": ["arabic", "transliteration", "sourceLanguage", "editorialStatus"],
      "properties": {
        "conceptId": { "type": "string", "pattern": "^[USTP][0-9]{3,}$" },
        "arabic": { "type": "string", "minLength": 1 },
        "transliteration": { "type": "string", "minLength": 1 },
        "sourceLanguage": { "const": "ar" },
        "sourceReferences": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/sourceReference" } },
        "editorialStatus": { "enum": ["DRAFT_REVIEW", "SOURCE_CHECK", "LINGUISTIC_REVIEW", "APPROVED"] }
      }
    },
    "projectMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "capability", "scope", "limitations"],
      "properties": {
        "label": { "$ref": "common.schema.json#/$defs/localizedText" },
        "capability": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "relation": { "const": "inspiredBy" },
    "status": { "enum": ["DRAFT_REVIEW", "SOURCE_CHECK", "LINGUISTIC_REVIEW", "APPROVED", "DEPRECATED"] },
    "authorityGranted": { "const": false },
    "review": { "$ref": "unilex.schema.json#/$defs/review" }
  }
}
