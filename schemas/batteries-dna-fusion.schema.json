{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://empireofthelight.example/schemas/batteries-dna-fusion.schema.json",
  "title": "Batteries DNA Fusion Recipe",
  "description": "Declares the first-party DNA metadata packages to preload into the main API process. This recipe does not execute their proposed capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "status", "loadMode", "registryId", "description", "executionEnabled", "authorityGranted", "components"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "const": "batteries-dna-fusion" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "const": "DRAFT_REVIEW" },
    "loadMode": { "const": "metadata_preload" },
    "registryId": { "const": "BATTERIES_DNA_ASMA_99" },
    "description": { "type": "string", "minLength": 1 },
    "executionEnabled": { "const": false },
    "authorityGranted": { "const": false },
    "components": {
      "type": "array",
      "minItems": 99,
      "maxItems": 99,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "packageName", "recordType", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^dna-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "packageName": { "type": "string", "pattern": "^@empire/batteries-dna-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "recordType": { "enum": ["bounded_project_mapping", "reference_only"] },
          "required": { "const": true }
        }
      }
    }
  }
}
