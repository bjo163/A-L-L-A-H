{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://empireofthelight.example/schemas/dictionary-entry.schema.json",
  "title": "Canonical Localized Dictionary Entry",
  "description": "Application dictionary entry linked to a source-aware UNILEX concept. Legacy dictionaries rows are not canonical until migrated.",
  "type": "object", "additionalProperties": false,
  "required": ["conceptId", "preferredLabel", "definition", "domain", "status"],
  "properties": {
    "conceptId": { "type": "string", "pattern": "^[USTP][0-9]{3,}$" },
    "preferredLabel": { "$ref": "common.schema.json#/$defs/localizedText" },
    "definition": { "$ref": "common.schema.json#/$defs/localizedText" },
    "domain": { "enum": ["UNIVERSAL", "SCRIPTURE", "TEXT_SOURCE", "PROJECT"] },
    "sourceLanguage": { "$ref": "common.schema.json#/$defs/locale" },
    "sourceForm": { "type": "string" },
    "transliteration": { "type": "string" },
    "alternateLabels": { "type": "object", "patternProperties": { "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } }, "additionalProperties": false },
    "sourceReferences": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sourceReference" } },
    "relations": { "type": "array", "items": { "$ref": "unilex.schema.json#/$defs/relation" } },
    "status": { "enum": ["DRAFT_REVIEW", "SOURCE_CHECK", "LINGUISTIC_REVIEW", "APPROVED", "DEPRECATED"] },
    "review": { "$ref": "unilex.schema.json#/$defs/review" }
  }
}
