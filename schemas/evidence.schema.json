{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://empireofthelight.example/schemas/evidence.schema.json",
  "title": "Research Evidence",
  "type": "object", "additionalProperties": false,
  "required": ["id", "researchRunId", "source", "classification", "excerpt", "provenance", "contentHash"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "researchRunId": { "$ref": "common.schema.json#/$defs/uuid" },
    "jobId": { "$ref": "common.schema.json#/$defs/uuid" },
    "source": { "$ref": "common.schema.json#/$defs/sourceReference" },
    "classification": { "enum": ["SCRIPTURE_TEXT", "TRADITION_INTERPRETATION", "HISTORICAL_CLAIM", "VERIFIED_MEASUREMENT", "SCIENTIFIC_MODEL", "HYPOTHESIS", "PROJECT_NARRATIVE", "PERSONAL_TESTIMONY"] },
    "excerpt": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uncertainty": { "$ref": "common.schema.json#/$defs/uncertainty" }
  }
}
