{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://empireofthelight.example/schemas/common.schema.json",
  "title": "Empire Common Contract Definitions",
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "dateTime": { "type": "string", "format": "date-time" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
    "localizedText": {
      "type": "object", "minProperties": 1,
      "patternProperties": { "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "sourceReference": {
      "type": "object", "additionalProperties": false, "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "familyId": { "type": "string", "minLength": 1 },
        "edition": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "languageTag": { "$ref": "#/$defs/locale" },
        "license": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "note": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "observedAt", "method"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "observedAt": { "$ref": "#/$defs/dateTime" },
        "collectedAt": { "$ref": "#/$defs/dateTime" },
        "method": { "type": "string", "minLength": 1 },
        "collectorId": { "type": "string" },
        "sourceVersion": { "type": "string" },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "license": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "uncertainty": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["unknown", "estimated", "measured", "interpreted", "disputed"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "type": "string" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "localizedError": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 },
        "messageKey": { "type": "string" },
        "details": {},
        "requestId": { "type": "string" }
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "page", "limit", "total"],
      "properties": {
        "items": { "type": "array" },
        "page": { "type": "integer", "minimum": 1 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "total": { "type": "integer", "minimum": 0 },
        "totalPages": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
