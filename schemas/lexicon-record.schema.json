{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://empireofthelight.example/schemas/lexicon-record.schema.json",
  "title": "Application Lexicon Record",
  "description": "A runtime cache/reference to source concepts or project mappings. It is not itself the canonical UNILEX editorial registry.",
  "type": "object", "additionalProperties": false,
  "required": ["code", "translit", "term", "attribute", "domain", "category"],
  "properties": {
    "code": { "type": "string", "minLength": 1 },
    "conceptId": { "type": ["string", "null"], "pattern": "^[USTP][0-9]{3,}$" },
    "arabic": { "type": ["string", "null"] },
    "translit": { "type": "string", "minLength": 1 },
    "term": { "type": "string", "minLength": 1, "description": "Canonical English label." },
    "attribute": { "type": "string", "minLength": 1, "description": "Stable English technical capability or mapping label." },
    "domain": { "type": "string", "minLength": 1, "description": "Canonical English domain label." },
    "localized": {
      "type": ["object", "null"],
      "patternProperties": {
        "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": {
          "type": "object", "additionalProperties": false,
          "properties": { "term": { "type": "string" }, "domain": { "type": "string" }, "description": { "type": "string" } }
        }
      },
      "additionalProperties": false
    },
    "sourceReference": { "$ref": "common.schema.json#/$defs/sourceReference" },
    "revelations": { "type": "string", "description": "Deprecated legacy field; do not treat as validated citation." },
    "wisdom": { "type": "string", "description": "Deprecated legacy field; not a theological definition." },
    "category": { "enum": ["asma", "concept", "entity", "axiom", "realm", "role", "project_mapping"] },
    "editorialStatus": { "enum": ["DRAFT_REVIEW", "SOURCE_CHECK", "LINGUISTIC_REVIEW", "APPROVED", "DEPRECATED"] }
  }
}
