# Copy this file to the repository root as .env. Never commit the populated file.
# Use a long URL-safe password (letters and numbers) because the API uses it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
FILE_STORAGE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
# Required only when provisioning the first owner (4-lah) and architect (shadow).
# Set two different strong passwords; no default operator passwords are installed.
EMPIRE_OWNER_PASSWORD=
EMPIRE_ARCHITECT_PASSWORD=
# Browser-visible origins; each UI is published directly, without a reverse proxy.
PUBLIC_ORIGIN=http://localhost:3300,http://localhost:3400
# This must be reachable from each user's browser, not just from inside Docker.
PUBLIC_API_ORIGIN=http://localhost:4000
BIND_ADDRESS=127.0.0.1
API_PORT=4000
PORTAL_PORT=3300
COMMAND_CENTER_PORT=3400
